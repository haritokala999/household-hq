rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    function userHouseholdPath(uid, householdId) {
      return /databases/$(database)/documents/users/$(uid)/households/$(householdId);
    }

    function householdInvitationCodePath(code) {
      return /databases/$(database)/documents/householdInvitationCodes/$(code);
    }

    function isActiveMember(householdId) {
      return signedIn()
        && exists(memberPath(householdId, request.auth.uid))
        && get(memberPath(householdId, request.auth.uid)).data.uid == request.auth.uid
        && get(memberPath(householdId, request.auth.uid)).data.status == 'active';
    }

    function isActiveMemberUid(householdId, uid) {
      return exists(memberPath(householdId, uid))
        && get(memberPath(householdId, uid)).data.uid == uid
        && get(memberPath(householdId, uid)).data.status == 'active';
    }

    function isOwner(householdId) {
      return isActiveMember(householdId)
        && get(memberPath(householdId, request.auth.uid)).data.role == 'owner';
    }

    function validName(name, maxLength) {
      return name is string
        && name.matches('.*\\S.*')
        && name.size() <= maxLength;
    }

    function validCurrency(currency) {
      return currency in ['USD', 'CAD', 'EUR', 'GBP', 'INR', 'SAR', 'KWD'];
    }

    function validAmount(amount, allowZero) {
      return amount is int
        && amount >= (allowZero ? 0 : 1)
        && amount <= 9007199254740991;
    }

    function validHousehold(data, ownerUid) {
      return data.keys().hasAll(['name', 'currency', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'currency', 'ownerUid', 'createdAt', 'updatedAt'])
        && validName(data.name, 80)
        && validCurrency(data.currency)
        && data.ownerUid == ownerUid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validMembership(data, uid, role, invitationId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'joinedAt', 'invitationId'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'joinedAt', 'invitationId'])
        && data.uid == uid
        && (data.email == null || data.email is string)
        && (data.displayName == null || data.displayName is string)
        && data.role == role
        && data.status == 'active'
        && data.joinedAt == request.time
        && data.invitationId == invitationId;
    }

    function validHouseholdIndex(data, householdId) {
      return data.keys().hasAll(['householdId', 'createdAt'])
        && data.keys().hasOnly(['householdId', 'createdAt', 'lastSeenAt'])
        && data.householdId == householdId
        && data.createdAt == request.time
        && (!('lastSeenAt' in data) || data.lastSeenAt == request.time);
    }

    function validCategory(data, createdBy) {
      return data.keys().hasAll(['name', 'kind', 'isDefault', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['name', 'kind', 'isDefault', 'createdBy', 'createdAt'])
        && validName(data.name, 60)
        && data.kind in ['income', 'expense', 'investment']
        && data.isDefault is bool
        && data.createdBy == createdBy
        && data.createdAt == request.time;
    }

    function validDefaultCategory(categoryId, data, uid) {
      return data.isDefault == true
        && data.createdBy == uid
        && data.createdAt == request.time
        && ((categoryId == 'cat-paycheck' && data.name == 'Paycheck' && data.kind == 'income')
          || (categoryId == 'cat-income-other' && data.name == 'Other income' && data.kind == 'income')
          || (categoryId == 'cat-groceries' && data.name == 'Groceries' && data.kind == 'expense')
          || (categoryId == 'cat-bills' && data.name == 'Bills' && data.kind == 'expense')
          || (categoryId == 'cat-shopping' && data.name == 'Shopping' && data.kind == 'expense')
          || (categoryId == 'cat-loan-payment' && data.name == 'Loan payment' && data.kind == 'expense')
          || (categoryId == 'cat-other-expense' && data.name == 'Other expense' && data.kind == 'expense')
          || (categoryId == 'cat-investment' && data.name == 'Investment contribution' && data.kind == 'investment'));
    }

    function validInitialHousehold(householdId, uid, household) {
      return signedIn()
        && uid == request.auth.uid
        && !exists(householdPath(householdId))
        && existsAfter(memberPath(householdId, uid))
        && existsAfter(userHouseholdPath(uid, householdId))
        && validHousehold(household, uid);
    }

    function validInitialMembership(householdId, uid, membership) {
      return signedIn()
        && uid == request.auth.uid
        && !exists(householdPath(householdId))
        && !exists(memberPath(householdId, uid))
        && validMembership(membership, uid, 'owner', null);
    }

    function validInitialIndex(householdId, uid, index) {
      let household = getAfter(householdPath(householdId)).data;
      let membership = getAfter(memberPath(householdId, uid)).data;
      return signedIn()
        && uid == request.auth.uid
        && !exists(userHouseholdPath(uid, householdId))
        && validHousehold(household, uid)
        && validMembership(membership, uid, 'owner', null)
        && validHouseholdIndex(index, householdId);
    }

    function validOwnerTransfer(householdId, oldOwnerUid, newOwnerUid) {
      return newOwnerUid is string
        && newOwnerUid != oldOwnerUid
        && request.auth.uid == oldOwnerUid
        && exists(memberPath(householdId, newOwnerUid))
        && get(memberPath(householdId, newOwnerUid)).data.status == 'active'
        && get(memberPath(householdId, newOwnerUid)).data.role in ['member', 'owner']
        && getAfter(householdPath(householdId)).data.ownerUid == newOwnerUid
        && getAfter(memberPath(householdId, oldOwnerUid)).data.role == 'member'
        && getAfter(memberPath(householdId, oldOwnerUid)).data.status == 'active'
        && getAfter(memberPath(householdId, newOwnerUid)).data.role == 'owner'
        && getAfter(memberPath(householdId, newOwnerUid)).data.status == 'active';
    }

    function validOwnershipRoleUpdate(householdId, memberUid) {
      let newOwnerUid = getAfter(householdPath(householdId)).data.ownerUid;
      let oldOwnerUid = get(householdPath(householdId)).data.ownerUid;
      let actorRoleAfter = getAfter(memberPath(householdId, request.auth.uid)).data.role;
      return isOwner(householdId)
        && newOwnerUid is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && ((resource.data.role == 'member'
            && request.resource.data.role == 'owner'
            && ((newOwnerUid == oldOwnerUid && actorRoleAfter == 'owner')
              || (newOwnerUid != oldOwnerUid
                && newOwnerUid == memberUid
                && actorRoleAfter == 'member')))
          || (memberUid == request.auth.uid
            && resource.data.role == 'owner'
            && request.resource.data.role == 'member'
            && newOwnerUid != oldOwnerUid
            && getAfter(memberPath(householdId, newOwnerUid)).data.role == 'owner'
            && actorRoleAfter == 'member'));
    }

    function validInvitation(data, householdId, invitationCode, creatorUid) {
      return data.keys().hasAll(['code', 'householdId', 'createdBy', 'createdAt', 'expiresAt', 'status', 'acceptedBy', 'acceptedAt'])
        && data.keys().hasOnly(['code', 'householdId', 'createdBy', 'createdAt', 'expiresAt', 'status', 'acceptedBy', 'acceptedAt'])
        && data.code is string
        && data.code.matches('^[A-Za-z0-9_-]{22}$')
        && data.code == invitationCode
        && data.householdId == householdId
        && data.createdBy == creatorUid
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(7, 'd')
        && data.status == 'pending'
        && data.acceptedBy == null
        && data.acceptedAt == null;
    }

    function isAcceptedInvite(householdId, uid, invitationId) {
      let path = householdInvitationCodePath(invitationId);
      let prior = get(path).data;
      let after = getAfter(path).data;
      return signedIn()
        && uid == request.auth.uid
        && prior.code == invitationId
        && prior.status == 'pending'
        && prior.expiresAt > request.time
        && after.status == 'accepted'
        && after.acceptedBy == uid
        && after.acceptedAt == request.time
        && after.householdId == householdId;
    }

    function validInvitedMembership(householdId, uid, membership) {
      return membership.invitationId is string
        && validMembership(membership, uid, 'member', membership.invitationId)
        && isAcceptedInvite(householdId, uid, membership.invitationId)
        && getAfter(userHouseholdPath(uid, householdId)).data.householdId == householdId;
    }

    function validInvitedIndex(uid, householdId) {
      let membership = getAfter(memberPath(householdId, uid)).data;
      return validHouseholdIndex(getAfter(userHouseholdPath(uid, householdId)).data, householdId)
        && validInvitedMembership(householdId, uid, membership);
    }

    function validOwnerUid(householdId, uid) {
      return uid is string && isActiveMemberUid(householdId, uid);
    }

    function validAccount(data, householdId, uid, isCreate) {
      return data.keys().hasAll(['name', 'kind', 'ownerUid', 'balanceMinor', 'currency', 'archived', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'kind', 'ownerUid', 'balanceMinor', 'currency', 'archived', 'createdBy', 'createdAt', 'updatedAt'])
        && validName(data.name, 80)
        && data.kind in ['savings', 'brokerage', 'retirement']
        && validOwnerUid(householdId, data.ownerUid)
        && validAmount(data.balanceMinor, true)
        && data.currency == get(householdPath(householdId)).data.currency
        && data.archived is bool
        && data.createdBy == (isCreate ? uid : resource.data.createdBy)
        && data.createdAt == (isCreate ? request.time : resource.data.createdAt)
        && data.updatedAt == request.time
        && (!isCreate || data.createdBy == uid)
        && (isCreate || data.ownerUid == resource.data.ownerUid);
    }

    function validTransactionCategory(category) {
      return category in [
        'Paycheck',
        'Paycheck transfer',
        'Groceries',
        'Housing & utilities',
        'Shopping',
        'Eatout',
        'Transportation',
        'Travel',
        'Savings and expenses',
        'Health and fitness',
        'India Transfer',
        'MISC'
      ];
    }

    function validBudgetCategory(category) {
      return validTransactionCategory(category)
        && category != 'Paycheck'
        && category != 'Paycheck transfer'
        && category != 'Savings and expenses';
    }

    function validTransaction(data, householdId, uid, isCreate) {
      return data.keys().hasAll(['type', 'purpose', 'transferDestination', 'category', 'description', 'amountMinor', 'date', 'accountId', 'ownerUid', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['type', 'purpose', 'transferDestination', 'category', 'description', 'amountMinor', 'date', 'accountId', 'sourceAccountId', 'ledgerApplied', 'ownerUid', 'createdBy', 'createdAt', 'updatedAt'])
        && data.type in ['credit', 'debit', 'transfer']
        && data.purpose in ['income', 'ordinary', 'investment']
        && ((data.type == 'credit' && data.purpose == 'income' && data.transferDestination == null)
          || (data.type == 'debit' && data.purpose in ['ordinary', 'investment'] && data.transferDestination == null)
          || (data.type == 'transfer' && data.purpose == 'investment'
            && data.transferDestination in ['brokerage', 'retirement', 'cash']
            && data.accountId is string
            && data.ledgerApplied == true
            && get(/databases/$(database)/documents/households/$(householdId)/accounts/$(data.accountId)).data.kind
              == (data.transferDestination == 'brokerage' ? 'brokerage' : data.transferDestination == 'retirement' ? 'retirement' : 'savings')
            && (((!('sourceAccountId' in data) || data.sourceAccountId == null) && data.category == 'Paycheck transfer')
              || (data.sourceAccountId is string
                && data.accountId != data.sourceAccountId
                && exists(/databases/$(database)/documents/households/$(householdId)/accounts/$(data.sourceAccountId))
                && data.category in ['Paycheck transfer', 'Savings and expenses']))))
        && (validTransactionCategory(data.category)
          || (!isCreate && data.category == resource.data.category))
        && (data.description is string && data.description.size() <= 240)
        && validAmount(data.amountMinor, false)
        && data.date is string
        && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$')
        && (data.accountId == null || (data.accountId is string && exists(/databases/$(database)/documents/households/$(householdId)/accounts/$(data.accountId))))
        && (!('sourceAccountId' in data) || data.sourceAccountId == null
          || (data.sourceAccountId is string && exists(/databases/$(database)/documents/households/$(householdId)/accounts/$(data.sourceAccountId))))
        && (!('ledgerApplied' in data) || data.ledgerApplied is bool)
        && (data.type == 'transfer' || !('sourceAccountId' in data) || data.sourceAccountId == null)
        && validOwnerUid(householdId, data.ownerUid)
        && data.createdBy == (isCreate ? uid : resource.data.createdBy)
        && data.createdAt == (isCreate ? request.time : resource.data.createdAt)
        && data.updatedAt == request.time
        && (!isCreate || data.createdBy == uid)
        && (isCreate || data.ownerUid == resource.data.ownerUid);
    }

    function validBudget(data, uid, isCreate) {
      return data.keys().hasAll(['month', 'category', 'limitMinor', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['month', 'period', 'category', 'limitMinor', 'createdBy', 'createdAt', 'updatedAt'])
        && data.month is string && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && (!('period' in data) || data.period in ['monthly', 'yearly'])
        && (!('period' in data) || data.period != 'yearly' || data.month.matches('^[0-9]{4}-01$'))
        && (validBudgetCategory(data.category)
          || (!isCreate && data.category == resource.data.category))
        && validAmount(data.limitMinor, true)
        && data.createdBy == (isCreate ? uid : resource.data.createdBy)
        && data.createdAt == (isCreate ? request.time : resource.data.createdAt)
        && data.updatedAt == request.time
        && (!isCreate || data.createdBy == uid);
    }

    function validRecurringPayment(data, uid, isCreate) {
      return data.keys().hasAll(['name', 'amountMinor', 'dueDay', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'amountMinor', 'dueDay', 'frequency', 'monthKey', 'createdBy', 'createdAt', 'updatedAt'])
        && validName(data.name, 80)
        && validAmount(data.amountMinor, false)
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && (!('frequency' in data) || data.frequency in ['monthly', 'once'])
        && (!('monthKey' in data) || (data.monthKey is string && data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
        && (!('frequency' in data) || data.frequency != 'once' || ('monthKey' in data && data.monthKey is string && data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
        && data.createdBy == (isCreate ? uid : resource.data.createdBy)
        && data.createdAt == (isCreate ? request.time : resource.data.createdAt)
        && data.updatedAt == request.time
        && (!isCreate || data.createdBy == uid);
    }

    function validGoal(data, householdId, uid, isCreate) {
      return data.keys().hasAll(['name', 'targetMinor', 'currentMinor', 'deadline', 'ownerUid', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'targetMinor', 'currentMinor', 'deadline', 'ownerUid', 'createdBy', 'createdAt', 'updatedAt'])
        && validName(data.name, 80)
        && validAmount(data.targetMinor, false)
        && validAmount(data.currentMinor, true)
        && (data.deadline == null || (data.deadline is string && data.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && validOwnerUid(householdId, data.ownerUid)
        && data.createdBy == (isCreate ? uid : resource.data.createdBy)
        && data.createdAt == (isCreate ? request.time : resource.data.createdAt)
        && data.updatedAt == request.time
        && (!isCreate || data.createdBy == uid)
        && (isCreate || data.ownerUid == resource.data.ownerUid);
    }

    function validManualValue(data, householdId, uid, isCreate) {
      return data.keys().hasAll(['name', 'amountMinor', 'ownerUid', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'amountMinor', 'ownerUid', 'createdBy', 'createdAt', 'updatedAt'])
        && validName(data.name, 80)
        && validAmount(data.amountMinor, true)
        && validOwnerUid(householdId, data.ownerUid)
        && data.createdBy == (isCreate ? uid : resource.data.createdBy)
        && data.createdAt == (isCreate ? request.time : resource.data.createdAt)
        && data.updatedAt == request.time
        && (!isCreate || data.createdBy == uid)
        && (isCreate || data.ownerUid == resource.data.ownerUid);
    }

    match /households/{householdId} {
      allow read: if isActiveMember(householdId);
      allow create: if signedIn()
        && validInitialHousehold(householdId, request.auth.uid, request.resource.data);
      allow update: if isActiveMember(householdId)
        && (request.resource.data.ownerUid == resource.data.ownerUid
          || validOwnerTransfer(householdId, request.auth.uid, request.resource.data.ownerUid))
        && (isOwner(householdId)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.currency == resource.data.currency))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['name', 'currency', 'ownerUid', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'currency', 'ownerUid', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.name, 80)
        && validCurrency(request.resource.data.currency)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if (signedIn() && memberUid == request.auth.uid)
          || isActiveMember(householdId);
        allow create: if validInitialMembership(householdId, memberUid, request.resource.data)
          || (signedIn()
            && request.resource.data.uid == memberUid
            && validInvitedMembership(householdId, memberUid, request.resource.data));
        allow update: if isOwner(householdId)
          && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'joinedAt', 'invitationId'])
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'joinedAt', 'invitationId'])
          && request.resource.data.uid == resource.data.uid
          && (request.resource.data.role == resource.data.role
            || validOwnershipRoleUpdate(householdId, memberUid))
          && request.resource.data.status == resource.data.status
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.invitationId == resource.data.invitationId
          && (request.resource.data.email == null || request.resource.data.email is string)
          && (request.resource.data.displayName == null || request.resource.data.displayName is string);
        allow delete: if isOwner(householdId)
          && memberUid != request.auth.uid
          && !existsAfter(userHouseholdPath(memberUid, householdId));
      }

      match /categories/{categoryId} {
        allow read: if isActiveMember(householdId);
        allow create: if (isActiveMember(householdId)
            && validCategory(request.resource.data, request.auth.uid)
            && !request.resource.data.isDefault)
          || (isActiveMember(householdId)
            && validCategory(request.resource.data, request.auth.uid)
            && validDefaultCategory(categoryId, request.resource.data, request.auth.uid));
        allow update: if false;
        allow delete: if isActiveMember(householdId) && !resource.data.isDefault;
      }

      match /accounts/{accountId} {
        allow read: if isActiveMember(householdId);
        allow create: if isActiveMember(householdId) && validAccount(request.resource.data, householdId, request.auth.uid, true);
        allow update: if isActiveMember(householdId) && validAccount(request.resource.data, householdId, request.auth.uid, false);
        allow delete: if isActiveMember(householdId);

        match /snapshots/{snapshotId} {
          allow read: if isActiveMember(householdId);
          allow create: if isActiveMember(householdId)
            && exists(/databases/$(database)/documents/households/$(householdId)/accounts/$(accountId))
            && request.resource.data.keys().hasAll(['month', 'amountMinor', 'recordedBy', 'createdAt'])
            && request.resource.data.keys().hasOnly(['month', 'amountMinor', 'recordedBy', 'createdAt'])
            && snapshotId == request.resource.data.month
            && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && validAmount(request.resource.data.amountMinor, true)
            && request.resource.data.recordedBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if isActiveMember(householdId);
        }
      }

      match /transactions/{transactionId} {
        allow read: if isActiveMember(householdId);
        allow create: if isActiveMember(householdId) && validTransaction(request.resource.data, householdId, request.auth.uid, true);
        allow update: if isActiveMember(householdId) && validTransaction(request.resource.data, householdId, request.auth.uid, false);
        allow delete: if isActiveMember(householdId);
      }

      match /activity/{activityId} {
        allow read: if isActiveMember(householdId);
        allow create: if isActiveMember(householdId)
          && request.resource.data.keys().hasAll(['actorUid', 'actorName', 'summary', 'createdAt'])
          && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'summary', 'createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 80
          && request.resource.data.summary is string
          && request.resource.data.summary.matches('.*\\S.*')
          && request.resource.data.summary.size() <= 180
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /budgets/{budgetId} {
        allow read: if isActiveMember(householdId);
        allow create: if isActiveMember(householdId) && validBudget(request.resource.data, request.auth.uid, true);
        allow update: if isActiveMember(householdId) && validBudget(request.resource.data, request.auth.uid, false);
        allow delete: if isActiveMember(householdId);
      }

      match /goals/{goalId} {
        allow read: if isActiveMember(householdId);
        allow create: if isActiveMember(householdId) && validGoal(request.resource.data, householdId, request.auth.uid, true);
        allow update: if isActiveMember(householdId) && validGoal(request.resource.data, householdId, request.auth.uid, false);
        allow delete: if isActiveMember(householdId);
      }

      match /recurringPayments/{paymentId} {
        allow read: if isActiveMember(householdId);
        allow create: if isActiveMember(householdId) && validRecurringPayment(request.resource.data, request.auth.uid, true);
        allow update: if isActiveMember(householdId) && validRecurringPayment(request.resource.data, request.auth.uid, false);
        allow delete: if isActiveMember(householdId);
      }

      match /{group}/{recordId} {
        allow read: if group in ['assets', 'liabilities'] && isActiveMember(householdId);
        allow create: if group in ['assets', 'liabilities']
          && isActiveMember(householdId)
          && validManualValue(request.resource.data, householdId, request.auth.uid, true);
        allow update: if group in ['assets', 'liabilities']
          && isActiveMember(householdId)
          && validManualValue(request.resource.data, householdId, request.auth.uid, false);
        allow delete: if group in ['assets', 'liabilities'] && isActiveMember(householdId);
      }
    }

    match /users/{uid}/households/{householdId} {
      allow get, list: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn()
        && validHouseholdIndex(request.resource.data, householdId)
        && (validInitialIndex(householdId, uid, request.resource.data)
          || validInvitedIndex(uid, householdId));
      allow update: if signedIn()
        && uid == request.auth.uid
        && isActiveMember(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(householdId)
        && uid != request.auth.uid
        && exists(memberPath(householdId, uid))
        && !existsAfter(memberPath(householdId, uid));
    }

    match /householdInvitationCodes/{invitationId} {
      // The document ID is a 128-bit bearer secret. Missing-code reads return
      // an empty result, while listing all invitation documents stays denied.
      allow get: if signedIn()
        && (!exists(householdInvitationCodePath(invitationId))
          || resource.data.code == invitationId);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.householdId is string
        && request.resource.data.createdBy == request.auth.uid
        && isOwner(request.resource.data.householdId)
        && validInvitation(request.resource.data, request.resource.data.householdId, invitationId, request.auth.uid);
      allow update: if signedIn()
        && resource.data.code == invitationId
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && getAfter(memberPath(resource.data.householdId, request.auth.uid)).data.invitationId == invitationId
        && getAfter(userHouseholdPath(request.auth.uid, resource.data.householdId)).data.householdId == resource.data.householdId;
      allow delete: if isOwner(resource.data.householdId) && resource.data.status == 'pending';
    }
  }
}
